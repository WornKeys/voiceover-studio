{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyOneRegion",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": "REGION" } }
    },
    {
      "Sid": "OnlyApprovedInstanceTypes",
      "Effect": "Deny",
      "Action": ["ec2:RunInstances", "ec2:StartInstances"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": { "ec2:InstanceType": ["g6.xlarge", "g5.xlarge", "g4dn.xlarge", "t3.medium"] }
      }
    },
    {
      "Sid": "OnlyAmazonOwnedImages",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": { "StringNotEquals": { "ec2:Owner": "amazon" } }
    },
    {
      "Sid": "MaxVolumeSize200GB",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": { "NumericGreaterThan": { "ec2:VolumeSize": "200" } }
    },
    {
      "Sid": "OnlyGp3Volumes",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": { "StringNotEquals": { "ec2:VolumeType": "gp3" } }
    },
    {
      "Sid": "NoPaidIops",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": { "NumericGreaterThan": { "ec2:VolumeIops": "3000" } }
    },
    {
      "Sid": "NoPaidThroughput",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": { "NumericGreaterThan": { "ec2:VolumeThroughput": "125" } }
    },
    {
      "Sid": "NoInboundPorts",
      "Effect": "Deny",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "*"
    },
    {
      "Sid": "NoCostlyExtras",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateNatGateway",
        "ec2:AllocateAddress",
        "ec2:AllocateHosts",
        "ec2:CreateVpcEndpoint",
        "ec2:CreateCapacityReservation",
        "ec2:CreateFleet",
        "ec2:RequestSpotFleet",
        "ec2:RequestSpotInstances",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "ec2:PurchaseScheduledInstances",
        "savingsplans:CreateSavingsPlan",
        "aws-marketplace:Subscribe",
        "servicequotas:RequestServiceQuotaIncrease"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OnlySsmManagedPolicyMayBeAttached",
      "Effect": "Deny",
      "Action": "iam:AttachRolePolicy",
      "Resource": "*",
      "Condition": {
        "ArnNotEquals": { "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore" }
      }
    },
    {
      "Sid": "NoBoundaryRemoval",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "ProtectProjectPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:policy/voiceover-studio-*"
    },
    {
      "Sid": "ProtectDeployerRole",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/VoiceoverStudioDeployer"
    }
  ]
}
