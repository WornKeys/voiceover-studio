{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperatorWithMfaOnly",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::ACCOUNT_ID:user/voiceover-operator" },
      "Action": "sts:AssumeRole",
      "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "true" } }
    }
  ]
}
