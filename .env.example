# Copy this file to .env and fill in your values. Never commit .env.
# Secrets never go in this file: it only holds the NAMES of SSM parameters that hold them.

# --- AWS -------------------------------------------------------------------
# Profile that assumes the deploy role (see docs/deploy.md, "One-time AWS setup").
AWS_PROFILE=voiceover
AWS_REGION=us-east-1
PROJECT_NAME=voiceover-studio

# GPU instance: g6.xlarge (L4 24 GB, default) | g5.xlarge (A10G 24 GB, if g6 isn't available).
# g4dn.xlarge (T4 16 GB) is too small for both local models. t3.medium only for COMPUTE_PROFILE=cpu.
INSTANCE_TYPE=g6.xlarge
ROOT_VOLUME_GB=150
# Only if AWS says it has no capacity for your instance type in the zone it picked (e.g. us-east-1b).
AVAILABILITY_ZONE=
# Stop the instance after this many minutes without anyone using the app (0 = off; a CloudWatch alarm
# still stops it after 60 minutes of near-zero CPU).
IDLE_STOP_MINUTES=30
# Monthly budget for this project, with email alerts.
BUDGET_MONTHLY_USD=30
BUDGET_EMAIL=you@example.com
# gpu | cpu. Leave empty to derive it from the providers below (any local model -> gpu).
COMPUTE_PROFILE=

# --- Providers -------------------------------------------------------------
# Text-to-speech: qwen3_tts (local, default) | fish_audio (hosted; your voice sample leaves AWS)
TTS_PROVIDER=qwen3_tts
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Model versions: empty = the version this release was tested with (for the default models), or the latest
# for any other model. Set a Hugging Face commit or tag to choose one. Same for LLM_ and ASR_MODEL_REVISION.
TTS_MODEL_REVISION=
# Only for hosted TTS: SSM SecureString parameter that holds the API key.
TTS_API_KEY_PARAM=

# Script writer: any OpenAI-compatible endpoint.
# Default: local vLLM on the same GPU. Amazon Bedrock also needs IAM permissions that v1.0.0 doesn't grant yet
# (docs/architecture.md, "Known gaps").
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://llm:8000/v1
# Qwen3.5-9B quantized to 4 bits (Apache-2.0, ~9 GB of GPU memory), served by vLLM on the same GPU.
LLM_MODEL=cyankiwi/Qwen3.5-9B-AWQ-4bit
LLM_MODEL_REVISION=
# Share of GPU memory for the local LLM; the voice model uses the rest. Context length in tokens.
LLM_GPU_MEMORY=0.5
LLM_MAX_MODEL_LEN=8192
# none | ssm | bedrock. Empty = inferred: a bedrock URL uses the instance role (no key at all),
# a key parameter uses SSM, otherwise none. Bedrock URL: https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
LLM_AUTH=
LLM_API_KEY_PARAM=
# Qwen3.x models "think" before answering unless this is on (faster, cleaner scripts).
LLM_DISABLE_THINKING=true

# Speech-to-text (consent check): local Whisper.
ASR_PROVIDER=faster_whisper
ASR_MODEL=small
ASR_MODEL_REVISION=
# cpu (default: fast enough for a 10-second clip, keeps GPU memory free) | cuda
ASR_DEVICE=cpu

# Where samples and outputs are stored: s3 (on AWS) | local (development)
STORAGE_PROVIDER=s3

# Optional: Hugging Face token parameter (only helps with download rate limits; models are not gated).
# Store the token first: ./scripts/secret.sh put /voiceover-studio/hf-token
HF_TOKEN_PARAM=

# --- Plugins ---------------------------------------------------------------
# Comma-separated list of enabled plugins: fit_to_length, translate (see docs/plugins.md).
PLUGINS=fit_to_length
