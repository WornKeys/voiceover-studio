# Copy this file to .env and fill in your values. Never commit .env.
# Secrets never go in this file: it only holds the NAMES of SSM parameters that hold them.

# --- AWS -------------------------------------------------------------------
# Profile that assumes the deploy role (see infra/bootstrap/README.md).
AWS_PROFILE=voiceover
AWS_REGION=us-east-1
PROJECT_NAME=voiceover-studio

# GPU instance: g6.xlarge (L4, default) | g5.xlarge (A10G) | g4dn.xlarge (T4, budget)
INSTANCE_TYPE=g6.xlarge
ROOT_VOLUME_GB=100
# Stop the instance after this many minutes without activity.
IDLE_STOP_MINUTES=30
# Monthly budget for this project, with email alerts.
BUDGET_MONTHLY_USD=30
BUDGET_EMAIL=you@example.com
# gpu | cpu. Leave empty to derive it from the providers below (any local model -> gpu).
COMPUTE_PROFILE=

# --- Providers -------------------------------------------------------------
# Text-to-speech: qwen3_tts (local, default) | fish_audio (hosted; your voice sample leaves AWS)
TTS_PROVIDER=qwen3_tts
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Only for hosted TTS: SSM SecureString parameter that holds the API key.
TTS_API_KEY_PARAM=

# Script writer: any OpenAI-compatible endpoint.
# Default: local vLLM on the same GPU. Optional fallback: Amazon Bedrock (see docs/providers.md).
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://llm:8000/v1
# Exact quantized model id is pinned during the build (docs/models.md).
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_API_KEY_PARAM=

# Speech-to-text (consent check): local Whisper.
ASR_PROVIDER=faster_whisper
ASR_MODEL=small

# Where samples and outputs are stored: s3 (on AWS) | local (development)
STORAGE_PROVIDER=s3

# Optional: Hugging Face token parameter (only helps with download rate limits; models are not gated).
HF_TOKEN_PARAM=

# --- Plugins ---------------------------------------------------------------
# Comma-separated list of enabled plugins.
PLUGINS=
